# Synthetic sample/test rules for development. These are NOT Emerging Threats rules.
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SAMPLE/TEST ET SCAN NMAP SYN window signature"; flags:S; window:1024; classtype:attempted-recon; metadata:sample true; sid:9900001; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"SAMPLE/TEST ET MALWARE generic beacon over TLS"; flow:established,to_server; content:"|16 03|"; depth:2; classtype:trojan-activity; sid:9900002; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SAMPLE/TEST ET EXPLOIT public web command injection"; flow:established,to_server; http.uri; content:"cmd="; nocase; pcre:"/[;&|]\\s*(?:whoami|id)/i"; classtype:web-application-attack; sid:9900003; rev:1;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"SAMPLE/TEST ET POLICY AnyDesk remote access software"; flow:established,to_server; tls.sni; content:"anydesk.com"; nocase; classtype:policy-violation; sid:9900004; rev:1;)
alert dns $HOME_NET any -> any 53 (msg:"SAMPLE/TEST ET DNS long high-entropy-looking query"; dns.query; pcre:"/^[a-z0-9]{45,}\\./i"; classtype:bad-unknown; sid:9900005; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SAMPLE/TEST ET WEB_SERVER SQL injection UNION SELECT"; flow:established,to_server; http.uri; content:"UNION"; nocase; content:"SELECT"; distance:0; classtype:web-application-attack; sid:9900006; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SAMPLE/TEST ET WEB_SERVER path traversal"; http.uri.raw; content:"../"; classtype:web-application-attack; sid:9900007; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444 (msg:"SAMPLE/TEST ET TROJAN generic reverse shell marker"; flow:established,to_server; content:"/bin/sh"; classtype:trojan-activity; sid:9900008; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SAMPLE/TEST ET MALWARE Cobalt Strike-like profile marker"; http.user_agent; content:"Mozilla/4.0"; http.uri; content:"/submit.php"; classtype:trojan-activity; sid:9900009; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 3389 (msg:"SAMPLE/TEST ET POLICY outbound RDP connection"; flow:established,to_server; content:"Cookie: mstshash="; classtype:policy-violation; sid:9900010; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SAMPLE/TEST ET WEB_SERVER possible web shell upload"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"<?php"; classtype:web-application-attack; sid:9900011; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"SAMPLE/TEST ET SCAN SSH service probe"; flow:to_server; content:"SSH-2.0-"; classtype:attempted-recon; sid:9900012; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"SAMPLE/TEST ET SCAN ICMP host discovery"; itype:8; classtype:attempted-recon; sid:9900013; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (msg:"SAMPLE/TEST ET EXPLOIT SMB exploit attempt marker"; flow:established,to_server; content:"|FF 53 4D 42|"; depth:4; classtype:attempted-admin; sid:9900014; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SAMPLE/TEST ET POLICY PowerShell download cradle in HTTP"; flow:established,to_server; http.request_body; content:"powershell"; nocase; content:"DownloadString"; nocase; classtype:policy-violation; sid:9900015; rev:1;)
alert dns $HOME_NET any -> any 53 (msg:"SAMPLE/TEST ET DNS repeated TXT query"; dns.query; dns.rrtype:TXT; classtype:bad-unknown; sid:9900016; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"SAMPLE/TEST ET DOS excessive SYN pattern"; flags:S; threshold:type both, track by_dst, count 100, seconds 1; classtype:attempted-dos; sid:9900017; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SAMPLE/TEST ET POLICY credential-like data in cleartext"; flow:established,to_server; http.request_body; content:"password="; nocase; classtype:policy-violation; sid:9900018; rev:1;)
alert tcp any any -> any any (msg:"SAMPLE/TEST generic network anomaly zero window"; flags:A; window:0; classtype:misc-activity; sid:9900019; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SAMPLE/TEST ET WEB_SERVER cross-site scripting marker"; http.uri; content:"<script"; nocase; classtype:web-application-attack; sid:9900020; rev:1;)


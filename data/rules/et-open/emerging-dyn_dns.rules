alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET DYN_DNS DYNAMIC_DNS HTTP Request to a *.freedynamicdns .net Domain"; flow:established,to_server; http.host; content:".freedynamicdns.net"; endswith; reference:url,www.noip.com/support/faq/free-dynamic-dns-domains/; classtype:bad-unknown; sid:2042732; rev:3; metadata:attack_target Client_and_Server, created_at 2022_12_13, deployment Perimeter, former_category INFO, performance_impact Low, confidence High, signature_severity Informational, updated_at 2024_06_11, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1568, mitre_technique_name Dynamic_Resolution;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET DYN_DNS DYNAMIC_DNS HTTP Request to a *.freedynamicdns .org Domain"; flow:established,to_server; http.host; content:".freedynamicdns.org"; endswith; reference:url,www.noip.com/support/faq/free-dynamic-dns-domains/; classtype:bad-unknown; sid:2042754; rev:3; metadata:attack_target Client_and_Server, created_at 2022_12_13, deployment Perimeter, former_category INFO, performance_impact Low, confidence High, signature_severity Informational, updated_at 2024_06_11, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1568, mitre_technique_name Dynamic_Resolution;)

alert dns $HOME_NET any -> any any (msg:"ET DYN_DNS DYNAMIC_DNS Query to *.dyndns. Domain"; dns.query; content:".dyndns."; nocase; content:!"update.dyndns.org"; depth:17; content:!"checkip.dyndns.org"; depth:18; classtype:misc-activity; sid:2012758; rev:9; metadata:created_at 2011_05_02, former_category INFO, confidence Medium, signature_severity Informational, tag Description_Generated_By_Proofpoint_Nexus, updated_at 2024_06_11;)

alert dns $HOME_NET any -> any any (msg:"ET DYN_DNS DYNAMIC_DNS Query for Suspicious .dyndns-at-home.com Domain"; dns.query; content:".dyndns-at-home.com"; fast_pattern; nocase; endswith; reference:url,help.dyn.com/list-of-dyn-dns-pro-remote-access-domain-names/; classtype:bad-unknown; sid:2013971; rev:8; metadata:created_at 2011_11_28, former_category INFO, confidence Medium, signature_severity Informational, updated_at 2024_06_11, reviewed_at 2024_04_10;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET DYN_DNS Dyndns Client IP Check"; flow:established,to_server; http.user_agent; content:"DynDNS-Client"; startswith; http.host; content:"checkip.dyndns."; classtype:not-suspicious; sid:2014091; rev:6; metadata:created_at 2012_01_03, former_category POLICY, signature_severity Informational, updated_at 2024_06_11;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET DYN_DNS Dyndns Client User-Agent"; flow:established,to_server; http.user_agent; content:"DynDNS-Client"; classtype:not-suspicious; sid:2014092; rev:5; metadata:created_at 2012_01_03, former_category POLICY, confidence High, signature_severity Informational, updated_at 2024_06_11;)


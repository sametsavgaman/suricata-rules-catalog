DATABASE_URL=postgresql+psycopg://suricata:suricata@db:5432/suricata
OPENAI_API_KEY=
OPENAI_MODEL=
AI_PROVIDER=openai
HELPER_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CLAUDE_API_KEY=
CLAUDE_MODEL=
CLAUDE_BASE_URL=https://api.anthropic.com
# Local provider: set AI_PROVIDER=ollama and CLASSIFIER_VERSION=qwen-v2.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1536
FRONTEND_ORIGIN=http://localhost:5173
MAX_AGENT_CONTENTS=20
MAX_AGENT_CONTENT_CHARS=4000
# Optional, model/account pricing supplied by the operator (currency units per 1M tokens).
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
GEMINI_INPUT_COST_PER_1M=
GEMINI_OUTPUT_COST_PER_1M=
AI_MAX_RETRIES=3
CLASSIFIER_VERSION=v1
MAX_TOOL_CALLS_PER_RULE=3
AGENT_AUTO_FINALIZE_CONFIDENCE=0.92
AGENT_TOOL_TRIGGER_CONFIDENCE=0.80
AGENT_MIN_ACCEPT_CONFIDENCE=0.70
